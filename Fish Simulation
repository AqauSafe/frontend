  #ana{position:fixed;inset:0;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center}
  #ana[hidden]{display:none}
  #ana .card{background:#0f2430;color:#e6f2f4;padding:14px;border-radius:12px;max-width:92vw;font-size:13px}
  #ch{width:340px;max-width:100%;height:auto;display:block;margin:8px 0}
  #hud{position:fixed;left:10px;top:10px;background:rgba(10,25,35,.62);color:#e6f2f4;padding:10px 12px;border-radius:10px;font-size:12px;backdrop-filter:blur(4px)}
  #hud label{display:flex;justify-content:space-between;margin-top:6px}
  #hud input{width:100%;margin:2px 0 0}
