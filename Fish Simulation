<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Catfish Pond</title>
<style>
  html,body{margin:0;height:100%;overflow:hidden;background:#0a1a24;font-family:system-ui,sans-serif}
  #c{display:block;width:100%;height:100%}
  #hud{max-height:92vh;overflow:auto;width:250px}
  #hud select,#hud button{width:100%;margin-top:6px;font-size:12px;padding:4px;border-radius:6px;border:0;background:#1f4256;color:#fff}
  #hud .row{display:flex;gap:4px}
